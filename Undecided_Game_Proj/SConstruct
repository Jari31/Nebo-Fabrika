# this is AI generated boilerplate. Feel free to change it if you really want to, as I certainly don't want to write my own SConstruct.
# if you're confused, do this inside of .../Undecided_Game_Proj : scons --target=NameOfLib
# use VS Code or VS Studio 2022

import os
import platform
# IMPORTANT: Import GetOption here!
from SCons.Script import Default, Environment, Glob, AddOption, GetOption

# --- 1. ENVIRONMENT SETUP ---
env = Environment(
    tools=['default', 'textfile'],
    ENV=os.environ
)

# --- 2. COMMAND LINE OPTIONS ---
AddOption('--target', dest='lib_name', type='string', default='my_extension', help='Name of the output library (e.g., my_extension)')
AddOption('--godot-cpp-root', dest='godot_cpp_root', type='string', default='godot-cpp', help='Path to the godot-cpp repository.')

# --- 3. SET VARIABLES ---
# Use GetOption() directly, not env.GetOption()
env['LIB_NAME'] = GetOption('lib_name')
env['GODOT_CPP_ROOT'] = GetOption('godot_cpp_root')

# Path to the final output DLL/SO (build folder)
env['GDEXTENSION_BUILD_DIR'] = '#build'

# --- 4. WINDOWS (MSVC) CONFIGURATION ---
print("Building for architecture x86_64 on platform windows (MSVC)")

# MSVC specific flags
env.Append(CXXFLAGS=['/EHsc', '/Zi', '/O2', '/std:c++17']) 
env.Append(LINKFLAGS=['/DEBUG'])

# Common Includes (The definitive, exhaustive search paths with /)
env.Append(CPPPATH=[
    '#src',
    # 1. Path to general includes (where most binding classes live)
    env['GODOT_CPP_ROOT'] + '/include',
    # 2. Path to core binding headers (e.g., String, Vector2)
    env['GODOT_CPP_ROOT'] + '/gen/core/include',
    # 3. Path for the GDExtension interface header (gdextension_interface.h) - Standard Location
    env['GODOT_CPP_ROOT'] + '/gen/gdextension/include',
    # 4. Fallback for generated class headers
    env['GODOT_CPP_ROOT'] + '/gen/include',
    # FIX: Add the root GDExtension folder (common alternative location for gdextension_interface.h)
    env['GODOT_CPP_ROOT'] + '/gdextension',
])

# Library paths and Linkage
env.Append(LIBPATH=[
    env['GDEXTENSION_BUILD_DIR'], 
    env['GODOT_CPP_ROOT'] + '/bin'
])

# Libraries: Windows needs the full name of the compiled .lib file
env.Append(LIBS=['libgodot-cpp.windows.template_debug.x86_64'])


# --- 5. EXECUTE BUILD ---
env.SConscript('SConscript', exports='env')

# Aliases
env.Alias('all', env['GDEXTENSION_BUILD_DIR'])
Default(env['GDEXTENSION_BUILD_DIR'])