#pragma once

struct float3
{
    float x, y, z;
};

inline float3 MakeVector3(float x, float y, float z)
{
    float3 vector = {x, y, z};
    return vector;
};

inline float3 AddVector3(float3 a, float3 b)
{
    return MakeVector3(a.x + b.x, a.y + b.y, a.z + b.z);
}

inline float3 SubtractVector3(float3 a, float3 b)
{
    return MakeVector3(a.x - b.x, a.y - b.y, a.z - b.z);
}

inline float3 MultiplyVector3(float3 a, float3 b)
{
    return MakeVector3(a.x * b.x, a.y * b.y, a.z * b.z);
}