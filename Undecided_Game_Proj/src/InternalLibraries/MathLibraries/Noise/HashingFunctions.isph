#pragma once
#include "../Vectors/Vectors.isph"

inline float Fractional(uniform float Value)
{
    return Value - floor(Value);
}

inline float3 ScalarGradientHash(float3 InputVector, uint32 Seed)
{
    uint32 x = intbits(InputVector.x);
    uint32 y = intbits(InputVector.y);
    uint32 z = intbits(InputVector.z);

    x = (x ^ Seed) * 0x45d9f3bu;
    y = (y ^ Seed) * 0x135a50f3u;
    z = (z ^ Seed) * 0x2c641115u;

    x ^= x >> 16;
    y ^= y >> 16;
    z ^= z >> 16;

    uint32 hash0 = x * 0x9e3779b9u;
    uint32 hash1 = y * 0x9e3779b9u;
    uint32 hash2 = z * 0x9e3779b9u;

    hash0 = ((hash0 >> 11) | (hash0 << 21)) ^ ((hash1 * 0x7331bf4bu) >> 13);
    hash1 = ((hash1 >> 11) | (hash1 << 21)) ^ ((hash2 * 0x7331bf4bu) >> 13);
    hash2 = ((hash2 >> 11) | (hash2 << 21)) ^ ((hash0 * 0x7331bf4bu) >> 13);

    float scale = 2.0f / 4294967296.0f;
    return MakeVector3(
        floatbits(hash0) * scale + -1.0f,
        floatbits(hash1) * scale + -1.0f,
        floatbits(hash2) * scale + -1.0f
    );
}
